{
  "permissions": {
    "allow": [
      "Bash(pnpm build)",
      "Bash(pnpm test *)",
      "Bash(pnpm typecheck)",
      "Bash(git status)",
      "Bash(git diff *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Edit(.env.*)"
    ],
    "ask": [
      "Bash(git push *)"
    ]
  },
  "enabledPlugins": {
    "stripe@claude-plugins-official": true
  }
}
