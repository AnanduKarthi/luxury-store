# Copy to .env.local and fill in real values. Never commit .env.local.

# Neon Postgres — pooled connection string from the Neon console
# (Dashboard → Connect → "Pooled connection")
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Better Auth
# Generate a secret with: pnpm exec auth secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET="replace-with-a-random-32+-char-secret"
# Base URL of the app (used for callbacks and cookies)
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL exposed to the browser (used by the auth client)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
